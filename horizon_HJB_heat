tf.disable_v2_behavior()
random.seed(42); np.random.seed(42); tf.set_random_seed(42)


xdim    = 5
T_final = 1.0
dt_hjb  = 0.01
layers  = [128,128,64, 1]

address = "/content/drive/MyDrive/Table 1 (3), case 2/0.6"
